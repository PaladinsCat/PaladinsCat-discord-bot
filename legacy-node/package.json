{
  "name": "paladinscat-discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "npm run test:assets",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "test:assets": "tsx --test test/asset-catalog.test.ts"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "puppeteer-core": "^24.15.0",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "undici": "^6.27.0"
  }
}
