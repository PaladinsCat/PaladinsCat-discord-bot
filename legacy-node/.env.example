PALADINSCAT_BOT_MODE=dummy
PALADINSCAT_API_URL=http://localhost:3304
PALADINSCAT_WEB_URL=http://localhost:3000
# Use fast database-only reads first. A missing match still enters the backend's
# durable requested-match ingestion pipeline before image rendering.
PALADINSCAT_BOT_LOCAL_ONLY=true
PALADINSCAT_ASSET_ROOT=../frontend/public/images
PALADINSCAT_BOT_HEALTH_PORT=3020
PALADINSCAT_RENDER_CONCURRENCY=1
PALADINSCAT_RENDER_QUEUE_LIMIT=10
PALADINSCAT_RENDER_TIMEOUT_MS=20000
PALADINSCAT_MATCH_LOOKUP_CONCURRENCY=2
PALADINSCAT_MATCH_LOOKUP_QUEUE_LIMIT=10
PALADINSCAT_MATCH_LOOKUP_TIMEOUT_MS=125000
# Internal service identity. The private key is runtime-mounted and never committed.
PALADINSCAT_SERVICE_OIDC_ISSUER=https://auth.example/realms/paladinscat
PALADINSCAT_SERVICE_OIDC_TOKEN_URL=https://auth.example/realms/paladinscat/protocol/openid-connect/token
PALADINSCAT_SERVICE_OIDC_CLIENT_ID=paladinscat-discord-service
PALADINSCAT_SERVICE_OIDC_PRIVATE_KEY_FILE=/run/secrets/paladinscat_discord_bot_private_key.pem
PALADINSCAT_RENDER_CACHE_BYTES=33554432
PALADINSCAT_RENDER_CACHE_TTL_MS=600000
# Required only when PALADINSCAT_BOT_MODE=real:
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Optional: register commands instantly in one development guild.
DISCORD_DEVELOPMENT_GUILD_ID=
