# Discord bot configuration
DISCORD_TOKEN=your_discord_token_here
APPLICATION_ID=your_application_id_here

# Backend API
API_BASE_URL=http://paladinscat-backend:3001/v1

# Internal service identity (private key remains in a runtime-mounted file)
PALADINSCAT_SERVICE_OIDC_ISSUER=https://auth.example/realms/paladinscat
PALADINSCAT_SERVICE_OIDC_TOKEN_URL=https://auth.example/realms/paladinscat/protocol/openid-connect/token
PALADINSCAT_SERVICE_OIDC_CLIENT_ID=paladinscat-discord-service
PALADINSCAT_SERVICE_OIDC_PRIVATE_KEY_FILE=/run/secrets/paladinscat_discord_bot_private_key.pem

# Optional: scope commands to dev guild (unset for global)
# DEVELOPMENT_GUILD_ID=

# Optional community commands (/random and voice-channel /teams)
ENABLE_SOCIAL_COMMANDS=false

# Cache tuning
CACHE_BYTES=33554432
CACHE_TTL_SECS=600

# Health server
HEALTH_PORT=3020

# Logging (trace, debug, info, warn, error)
RUST_LOG=info
